# SMS is preview-only by default. No real phone numbers belong in this file.
SMS_MODE=preview
# sms (default) or whatsapp
MESSAGING_CHANNEL=whatsapp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Sandbox sender shown in Twilio Console, e.g. whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=
DOCTOR_PHONE=
APP_URL=http://localhost:3000
# Required for live sends; use a strong secret, never NEXT_PUBLIC_*.
SMS_SEND_TOKEN=

# Supabase (optional; see docs/supabase.md). Without these: no sign-in, in-memory demo alerts.
# Publishable key only. Never put a secret or service-role key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=https://aubtnsvksswxpghmamuu.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Defaults to supabase when both Supabase variables are set.
# COVERAGE_ALERTS_SOURCE=supabase
# Patient data and WhatsApp receipts still use a writable DuckDB file.
# Local default: data/scenario.duckdb. On a host, point to its persistent disk.
# RUINED_DB=/absolute/path/to/scenario.duckdb
# Full deployment settings: docs/environment.md. Validate: npm run env:check
# Optional pipeline-backed Coverage Watchdog; run npm run demo:prepare first.
# COVERAGE_ALERTS_SOURCE=aggregate
# COVERAGE_ALERTS_PAYLOAD=data/raw/coverage-alerts.json
# Optional: return only active impacts matched to this demo prescriber (server-only).
# COVERAGE_ALERTS_NPI=0000000000
